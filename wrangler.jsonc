{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "controlo-crunchequation",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",

  // As páginas estáticas. run_worker_first obriga o Worker a correr sempre primeiro,
  // para que nada seja servido antes de a palavra-passe ser verificada.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Namespace controlo-estado.
  "kv_namespaces": [
    {
      "binding": "ESTADO",
      "id": "c7bd2d7578df49049c8953453af9a27f"
    }
  ]
}
